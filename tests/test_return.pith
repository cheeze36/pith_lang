###
# Regression tests for `return`: bare return, returning a void call, and
# returning from inside loops and try/finally (bare return used to crash, and
# `return void_call()` used to fall through and keep running).
###

define void log(string m):
    print("log: " + m)
define void early(int x):
    if (x == 1):
        return log("one")
    print("after")
early(1)
early(2)
define int pick(int x):
    for (int i = 0; i < 10; i = i + 1):
        if (i == x):
            return i * 10
    return -1
print(pick(3))
define void loop_return():
    foreach (int n in [1, 2, 3]):
        if (n == 2):
            return
        print(n)
    print("not reached")
loop_return()
define void in_try():
    try:
        return
    finally:
        print("finally ran")
    print("not reached")
in_try()
define int must_return(int x):
    if (x > 0):
        return
    return 1
try:
    must_return(5)
rescue e:
    print(e)
